<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Suite line (1.x): Jellyfin 12+ ONLY. The 10.11.x line stays served by the released
         v0.9.0 build. Jellyfin 12 runs on .NET 10 and its SDK packages ship net10.0 only. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.MaintenanceDeluxe</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.MaintenanceDeluxe</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.MaintenanceDeluxe.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jellyfin SDK — ExcludeAssets:runtime because the server provides these at runtime -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Still needed for the JObject payload sent to JS Injector via reflection (legacy fallback
         path; the primary delivery is now our own IStartupFilter middleware). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Configuration\admin.js" />
    <EmbeddedResource Include="Configuration\admin.js" />
    <None Remove="Configuration\admin.css" />
    <EmbeddedResource Include="Configuration\admin.css" />
    <None Remove="Resources\banner.js" />
    <EmbeddedResource Include="Resources\banner.js" />
    <None Remove="Resources\Fonts\Inter-Variable.woff2" />
    <EmbeddedResource Include="Resources\Fonts\Inter-Variable.woff2" />
    <None Remove="Resources\Fonts\JetBrainsMono-Variable.woff2" />
    <EmbeddedResource Include="Resources\Fonts\JetBrainsMono-Variable.woff2" />
    <None Remove="Resources\Fonts\SpaceGrotesk-Variable.woff2" />
    <EmbeddedResource Include="Resources\Fonts\SpaceGrotesk-Variable.woff2" />
    <None Remove="Resources\Fonts\Manrope-Variable.woff2" />
    <EmbeddedResource Include="Resources\Fonts\Manrope-Variable.woff2" />
  </ItemGroup>

</Project>
